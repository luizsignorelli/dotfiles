bindkey "^[[3~" delete-char

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

eval "$(starship init zsh)"

# Deep shell history. thoughtbot's zsh/configs/history.zsh sets both of these to
# 32768 and loads before this file. zsh only writes out what HISTSIZE holds in
# memory, so raising SAVEHIST alone does nothing -- both have to go up.
HISTSIZE=1000000
SAVEHIST=1000000

# libpq, for the pg gem. Installed by setup/3.1-work.sh, so guard it -- this
# file is shared with machines that never run that script.
if [ -d /opt/homebrew/opt/libpq/bin ]; then
  export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
fi

# Used by the ggpull/ggpush aliases in aliases.local.
# (vendored from oh-my-zsh's git plugin)
function git_current_branch() {
  local ref
  ref=$(command git symbolic-ref --quiet HEAD 2> /dev/null)
  local ret=$?
  if [[ $ret != 0 ]]; then
    [[ $ret == 128 ]] && return  # no git repo.
    ref=$(command git rev-parse --short HEAD 2> /dev/null) || return
  fi
  echo ${ref#refs/heads/}
}
